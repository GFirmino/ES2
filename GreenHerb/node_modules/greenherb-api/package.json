{
  "name": "greenherb-api",
  "version": "1.0.0",
  "description": "API REST para a plataforma GREENHERB - Sprint 1.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:integration": "newman run postman/greenherb-sprint4.postman_collection.json -e postman/local.postman_environment.json --reporters cli,json --reporter-json-export reports/newman-sprint4-report.json",
    "test:all": "npm test && npm run test:integration"
  },
  "keywords": [
    "greenherb",
    "express",
    "jest",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "newman": "^6.2.1"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
